<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Não reescreve requisições para arquivos ou diretórios que existem de fato
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Qualquer outra rota (client-side routing do Angular) cai no index.html
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType application/wasm .wasm
</IfModule>
